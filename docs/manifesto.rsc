1:["$","main",null,{"id":"top","children":[["$","$L7",null,{}],["$","section",null,{"className":"page-hero manifesto-hero","children":[["$","div",null,{"className":"eyebrow","children":"[ 02 — Манифест ]"}],["$","h1",null,{"children":["ВО ЧТО",["$","br",null,{}],["$","span",null,{"children":"МЫ ВЕРИМ"}]]}],["$","p",null,{"children":"Не список услуг и не корпоративные формулировки. Честный, прямой взгляд на медиа, бизнес и технологии."}]]}],["$","section",null,{"className":"manifesto-intro section","children":["$","p",null,{"children":["Мы не догоняем изменения.",["$","br",null,{}],["$","em",null,{"children":"Мы двигаемся вместе с ними"}]," — и помогаем вашему бренду делать то же самое."]}]}],["$","section",null,{"className":"manifesto-lines section","children":[["$","article","01",{"className":"manifesto-line","children":[["$","span",null,{"children":"01"}],["$","h2",null,{"children":"Каждый бизнес заслуживает быть услышанным."}],["$","p",null,{"children":"Не только корпорации с многомиллионными бюджетами. Любой, у кого есть идея, продукт и желание менять что-то вокруг себя."}]]}],["$","article","02",{"className":"manifesto-line","children":[["$","span",null,{"children":"02"}],["$","h2",null,{"children":"Медиапространство стало новой реальностью."}],["$","p",null,{"children":"Здесь формируется доверие, принимаются решения о покупке, рождаются и умирают репутации. Если вашего бренда здесь нет — вас не существует."}]]}],["$","article","03",{"className":"manifesto-line","children":[["$","span",null,{"children":"03"}],["$","h2",null,{"children":"Мы создаём присутствие, а не шум."}],["$","p",null,{"children":"Не хаотичные посты ради галочки и не красивые картинки без смысла. Мы строим системы — стратегически выверенные, технологичные и человечески понятные."}]]}],["$","article","04",{"className":"manifesto-line","children":[["$","span",null,{"children":"04"}],["$","h2",null,{"children":"Мы верим в силу истории."}],["$","p",null,{"children":"Любой бизнес — история основателя, продукта и людей, которым он нужен. Наша задача — рассказать её так, чтобы аудитория почувствовала: это про меня."}]]}],["$","article","05",{"className":"manifesto-line","children":[["$","span",null,{"children":"05"}],["$","h2",null,{"children":"Технологии должны служить смыслу."}],["$","p",null,{"children":"AI — уже настоящее. Но технология без идеи — инструмент без цели. Мы используем искусственный интеллект там, где он усиливает человеческое, а не заменяет его."}]]}],["$","article","06",{"className":"manifesto-line","children":[["$","span",null,{"children":"06"}],["$","h2",null,{"children":"Мы верим в честную работу."}],["$","p",null,{"children":"Без обещаний, которые невозможно выполнить, и отчётов, скрывающих реальность. Мы прямо говорим, что можем сделать, в какие сроки и с каким результатом."}]]}],["$","article","07",{"className":"manifesto-line","children":[["$","span",null,{"children":"07"}],["$","h2",null,{"children":"Настоящий результат строится годами."}],["$","p",null,{"children":"Один вирусный ролик не создаёт бренд. Один удачный месяц не рождает лояльность. Мы выбираем системную работу и долгосрочное мышление."}]]}],["$","article","08",{"className":"manifesto-line","children":[["$","span",null,{"children":"08"}],["$","h2",null,{"children":"Мы — наш собственный главный кейс."}],["$","p",null,{"children":"Наши аватары работают. Контент выходит. Стратегия реализуется. Всё, что предлагаем клиентам, мы сначала проверяем на себе."}]]}]]}],["$","section",null,{"className":"manifesto-end","children":[["$","p",null,{"children":"Добро пожаловать"}],["$","h2",null,{"children":["НА ПОРОГ",["$","br",null,{}],"НОВОГО."]}],["$","a",null,{"href":"/#contact","children":["Начать проект ",["$","span",null,{"className":"icon-arrow icon-arrow-up-right","aria-hidden":"true","children":["$","svg",null,{"width":"14","height":"14","viewBox":"0 0 14 14","fill":"none","xmlns":"http://www.w3.org/2000/svg","children":["$","path",null,{"d":"M1 13L13 1M13 1H3M13 1V11","stroke"