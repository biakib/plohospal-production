1:["$","main",null,{"id":"top","children":[["$","$L7",null,{}],["$","section",null,{"className":"privacy-page section","children":[["$","div",null,{"className":"eyebrow","children":"[ Правовая информация ]"}],["$","h1",null,{"children":["ПОЛИТИКА",["$","br",null,{}],"ОБРАБОТКИ",["$","br",null,{}],"ДАННЫХ"]}],["$","div",null,{"className":"privacy-grid","children":[["$","aside",null,{"className":"privacy-meta","children":[["$","p",null,{"children":"Дата публикации: 7 августа 2026 года"}],["$","p",null,{"children":["Оператор персональных данных:",["$","br",null,{}],["$","strong",null,{"children":"Бушманов Илья Юрьевич"}],["$","br",null,{}],"основатель-идеолог PLOHOSPAL Production"]}],["$","p",null,{"children":["$","a",null,{"href":"mailto:Bimperv@yandex.ru","children":"Bimperv@yandex.ru"}]}]]}],["$","div",null,{"className":"privacy-content","children":[["$","section",null,{"children":[["$","h2",null,{"children":"1. О чём эта политика"}],["$","p",null,{"children":"Политика описывает, как Бушманов Илья Юрьевич обрабатывает персональные данные посетителей сайта PLOHOSPAL Production. Используя форму брифа, посетитель предоставляет данные добровольно и даёт согласие на их обработку в целях ответа на обращение."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"2. Какие данные обрабатываются"}],["$","p",null,{"children":"Через форму могут быть получены:"}],["$","ul",null,{"children":[["$","li",null,{"children":"имя;"}],["$","li",null,{"children":"контакт для связи: Telegram, номер телефона или email;"}],["$","li",null,{"children":"описание задачи, указанное посетителем."}]]}],["$","p",null,{"children":"Сайт не запрашивает специальные категории или биометрические персональные данные."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"3. Для чего нужны данные"}],["$","p",null,{"children":"Данные используются только для рассмотрения запроса, связи с посетителем, подготовки персонального предложения и дальнейшей коммуникации по его инициативе."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"4. Как работает форма"}],["$","p",null,{"children":"Сайт не отправляет данные из формы автоматически на сервер. После нажатия кнопки браузер формирует текст брифа, копирует его в буфер обмена и открывает Telegram. Посетитель самостоятельно решает, отправлять ли сообщение. Если он отправляет его в Telegram, обработка данных также регулируется правилами соответствующего сервиса."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"5. Основание и срок обработки"}],["$","p",null,{"children":"Основание обработки — согласие посетителя, выраженное установкой отдельного чекбокса в форме. Данные обрабатываются до достижения цели обращения или до отзыва согласия, если более длительное хранение не требуется законодательством."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"6. Права посетителя"}],["$","p",null,{"children":["Посетитель может запросить сведения об обработке своих данных, уточнить их, потребовать ограничить обработку или отозвать согласие. Для этого нужно написать на ",["$","a",null,{"href":"mailto:Bimperv@yandex.ru","children":"Bimperv@yandex.ru"}]," с темой «Персональные данные»."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"7. Защита и передача данных"}],["$","p",null,{"children":"Оператор принимает разумные организационные и технические меры для защиты данных от неправомерного доступа. Данные не продаются и не передаются третьим лицам, кроме случаев, предусмотренных законодательством или прямо инициированных посетителем, например при самостоятельной отправке брифа в Telegram."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"8. Изменения политики"}],["$","p",null,{"children":"Политика может обновляться при изменении работы сайта или требований законодательства. Актуальная версия всегда размещается на этой странице."}]]}]]}]]}]]}],["$","$L8",null,{}]]}]
